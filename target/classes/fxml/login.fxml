<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="rs.autoservice.controller.LoginController"
           prefHeight="520.0" prefWidth="480.0" styleClass="login-bg" stylesheets="@../css/style.css">

    <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0" styleClass="login-card">
        <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
        </padding>

        <!-- Naslov i ikona -->
        <VBox alignment="CENTER" spacing="6.0">
            <Label text="🚗" style="-fx-font-size: 42px;" />
            <Label text="Auto Servis" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            <Label text="Management System (CS202)" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
        </VBox>

        <Separator />

        <!-- Forma za unos -->
        <VBox spacing="14.0">
            <VBox spacing="4.0">
                <Label text="Korisničko ime:" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                <TextField fx:id="usernameField" promptText="Unesite korisničko ime (npr. admin)" />
            </VBox>

            <VBox spacing="4.0">
                <Label text="Lozinka:" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                <PasswordField fx:id="passwordField" promptText="Unesite lozinku (npr. admin123)" />
            </VBox>

            <Label fx:id="errorLabel" textFill="#dc2626" wrapText="true" visible="false" style="-fx-font-size: 12px;" />

            <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" onAction="#handleLogin"
                    styleClass="btn-primary" text="Prijavi se na sistem" />
        </VBox>

        <Separator />

        <!-- Brza prijava za demonstraciju -->
        <VBox alignment="CENTER" spacing="8.0">
            <Label text="Brza prijava za odbranu projekta:" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
            <HBox alignment="CENTER" spacing="10.0">
                <Button onAction="#handleQuickAdmin" styleClass="btn-secondary" text="👤 Admin (admin/admin123)" />
                <Button onAction="#handleQuickEmployee" styleClass="btn-secondary" text="👨‍🔧 Radnik (radnik/radnik123)" />
            </HBox>
        </VBox>
    </VBox>
</StackPane>
